    "ky": "^2.0.2",
    "textarea-caret": "^3.1.0"
  },
  "devDependencies": {
    "ts-loader": "^9.6.2",
    "@types/node": "^26.1.1",
    "typescript": "^5.0.0",
    "webpack": "^5.108.4",
