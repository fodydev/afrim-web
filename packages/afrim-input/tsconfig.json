{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "lib": ["dom", "es2020"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "outDir": "./dist/",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "target": "es2020",
    "types": ["node"],
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "strict": true
  }
}
